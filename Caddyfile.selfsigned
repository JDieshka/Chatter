# Caddy reverse proxy БЕЗ домена: самоподписанный сертификат для IP-адреса.
# Домен/IP подставляется из переменной окружения DOMAIN (см. setup-https.sh).
#
# Как это работает:
#   - Caddy генерирует локальный CA и сертификат на {$DOMAIN} (это может быть просто IP);
#   - браузер покажет предупреждение «соединение не защищено» — его нужно принять один раз;
#   - HTTPS-контекст при этом настоящий: getUserMedia (микрофон) и wss:// работают.
#
# Ограничение: если у вас динамический публичный IP, при его смене сертификат
# придётся пересоздать (перезапустить контейнер caddy), а браузеру — заново
# принять новое предупреждение.

{$DOMAIN} {
        # tls internal — встроенный локальный CA Caddy (самоподписанный сертификат)
        tls internal

        encode gzip

        handle {
                reverse_proxy app:8080 {
                        header_up X-Forwarded-Proto https
                }
        }
}
