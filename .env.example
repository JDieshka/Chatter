# Обязательный секрет подписи JWT. Сгенерируйте, например: openssl rand -hex 32
JWT_SECRET=change-me-please

# Порт приложения на хосте (по умолчанию 8080)
APP_PORT=8080

# Учётные данные PostgreSQL (используются docker-compose)
DB_USER=chatter
DB_PASSWORD=chatter
DB_NAME=chatter

# Домен ИЛИ публичный IP сервера для HTTPS (Caddy). Пусто = HTTP без Caddy.
# С доменом: Let's Encrypt (зелёный замок). Без домена (IP): самоподписанный сертификат,
# браузер покажет предупреждение — принять один раз, микрофон и wss:// будут работать.
DOMAIN=
